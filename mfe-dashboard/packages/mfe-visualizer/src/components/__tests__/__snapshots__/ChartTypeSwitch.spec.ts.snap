// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ChartTypeSwitch > rendering > matches snapshot with bar selected 1`] = `"<div class="flex gap-1 p-0.5 border border-solid border-border rounded-sm" role="radiogroup" aria-label="Chart type"><button class="py-1 px-2 text-xs border-none bg-transparent text-secondary cursor-pointer transition-all hover:text-primary font-semibold !text-primary bg-primary" aria-checked="true" role="radio"> Bar </button><button class="py-1 px-2 text-xs border-none bg-transparent text-secondary cursor-pointer transition-all hover:text-primary" aria-checked="false" role="radio"> Pie </button></div>"`;

exports[`ChartTypeSwitch > rendering > matches snapshot with pie selected 1`] = `"<div class="flex gap-1 p-0.5 border border-solid border-border rounded-sm" role="radiogroup" aria-label="Chart type"><button class="py-1 px-2 text-xs border-none bg-transparent text-secondary cursor-pointer transition-all hover:text-primary" aria-checked="false" role="radio"> Bar </button><button class="py-1 px-2 text-xs border-none bg-transparent text-secondary cursor-pointer transition-all hover:text-primary font-semibold !text-primary bg-primary" aria-checked="true" role="radio"> Pie </button></div>"`;
